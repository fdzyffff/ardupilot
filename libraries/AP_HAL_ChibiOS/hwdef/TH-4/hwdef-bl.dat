# chibios_hwdef.py处理的硬件定义文件


# MCU类别和特定类型
MCU STM32H7xx STM32H743xx

# 晶振频率
OSCILLATOR_HZ 16000000

# 固件加载的板卡ID
APJ_BOARD_ID 777

# FLASH 的大小
FLASH_SIZE_KB 2048

# 引导加载程序安装在零偏移处
FLASH_RESERVE_START_KB 0

# 引导加载程序放置固件的位置
# H743有128k个扇形分区
FLASH_BOOTLOADER_LOAD_KB 128

# ChibiOS系统计时器
STM32_ST_USE_TIMER 2

PF15 LED_BOOTLOADER OUTPUT OPENDRAIN HIGH

define HAL_LED_ON 0

# UART（和USB）的顺序
SERIAL_ORDER OTG1 UART7

# UART7 is debug
#下面这写没看懂是什么意思
PF6 UART7_RX UART7 NODMA
PE8 UART7_TX UART7 NODMA

PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

define HAL_USE_EMPTY_STORAGE 1
define HAL_STORAGE_SIZE 32768

define BOOTLOADER_DEBUG SD7

# 添加CS引脚以确保它们在引导加载程序中处于高位
PF5 ADIS16470_CS CS
PD6 ICM42688_CS CS SPEED_VERYLOW
PI2 FRAM_CS CS SPEED_VERYLOW
PE3 MS5611_CS CS
