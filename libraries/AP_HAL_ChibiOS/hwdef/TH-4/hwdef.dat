# 该文件用于定义飞控硬件的设计定义，系统将根据该文件编译对应的固件以适应该版本硬件的设计。

# MCU的型号和特定类型
MCU STM32H7xx STM32H743xx

# 晶振频率定义
OSCILLATOR_HZ 16000000

# 固件加载的板卡ID
# 这个是什么意思？或者具体用的时候该怎么赋值？
APJ_BOARD_ID 777

# FLASH 的大小
FLASH_SIZE_KB 2048


# 对于2M闪存的FLASH进行速度优化
# 这个是什么意思？或者具体用的时候该怎么赋值？
env OPTIMIZE -O2


# ChibiOS系统计时器
# 这个是代表什么？
STM32_ST_USE_TIMER 2


#引导加载程序占用第一个扇区
FLASH_RESERVE_START_KB 128

# UART（和USB）的顺序
# 这条语句的语法规则是什么？
SERIAL_ORDER OTG1 USART1 USART3 USART2 UART4 UART5 USART6 UART7 UART8 OTG2

# 在更新驱动程序之前，将第二个接口默认为MAVLink2
define HAL_OTG2_PROTOCOL SerialProtocol_MAVLink2

# 定义USB连接的引脚
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# 使用烧录器探针进行SWD调试的引脚
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# SPI1 - 内部imu传感器，ICM-42688-P
PA5 SPI1_SCK SPI1
PG9 SPI1_MISO SPI1
PD7 SPI1_MOSI SPI1

# SPI2 - FRAM, FM25V05
# 这个没明白代表的是什么
PI1 SPI2_SCK SPI2
PC2 SPI2_MISO SPI2
PC3 SPI2_MOSI SPI2

# SPI4 - 内部气压计，MS5611
PE2 SPI4_SCK SPI4
PE5 SPI4_MISO SPI4
PE6 SPI4_MOSI SPI4

# SPI5 - 内部imu传感器, ADIS16470
PF7 SPI5_SCK SPI5
PF8 SPI5_MISO SPI5
PF9 SPI5_MOSI SPI5


# 这几行代码是什么意思？作用是什么？
PF5 ADIS16470_CS CS
PD6 ICM42688_CS CS
PI2 FRAM_CS CS SPEED_VERYLOW
PE3 MS5611_CS CS

# I2C总线

# 板载 内部I2C总线1
PB8 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

# 外部I2C总线2
PF1 I2C2_SCL I2C2
PF0 I2C2_SDA I2C2

# I2C3
PH7 I2C3_SCL I2C3
PH8 I2C3_SDA I2C3

# I2C总线的顺序
I2C_ORDER I2C1 I2C2 I2C3

define HAL_I2C_INTERNAL_MASK 1

# 启用引脚
PC13 VDD_3V3_SENSORS_EN OUTPUT LOW
PC14 VDD_3V3_SD_CARD_EN OUTPUT HIGH

# USART1定义为串口1
PB15 USART1_RX USART1
PB14 USART1_TX USART1

# USART3 定义义为串口2
PD9  USART3_RX USART3 NODMA
PB10 USART3_TX USART3 NODMA

# USART2 默认为GPS1
PA3 USART2_RX USART2 NODMA
PD5 USART2_TX USART2 NODMA

# UART4 默认为GPS2
PH14 UART4_RX UART4
PD1  UART4_TX UART4

# UART5
PB12 UART5_RX UART5 NODMA
PB13 UART5_TX UART5 NODMA

# USART6
PC7  USART6_RX USART6 NODMA
PG14 USART6_TX USART6 NODMA

# UART7
PF6 UART7_RX UART7 NODMA
PE8 UART7_TX UART7 NODMA

# UART8
PE0 UART8_RX UART8 NODMA
PE1 UART8_TX UART8 NODMA

# PWM 通道
PA0  TIM5_CH1 TIM5 PWM(1) GPIO(50)
PH11 TIM5_CH2 TIM5 PWM(2) GPIO(51)
PH12 TIM5_CH3 TIM5 PWM(3) GPIO(52)
PI0  TIM5_CH4 TIM5 PWM(4) GPIO(53)
PD12 TIM4_CH1 TIM4 PWM(5) GPIO(54)
PD13 TIM4_CH2 TIM4 PWM(6) GPIO(55)
PD14 TIM4_CH3 TIM4 PWM(7) GPIO(56)
PD15 TIM4_CH4 TIM4 PWM(8) GPIO(57)

PE9  TIM1_CH1  TIM1  PWM(9)  GPIO(58)
PE11 TIM1_CH2  TIM1  PWM(10) GPIO(59)
PE13 TIM1_CH3  TIM1  PWM(11) GPIO(60)
PE14 TIM1_CH4  TIM1  PWM(12) GPIO(61)
PH6  TIM12_CH1 TIM12 PWM(13) GPIO(62) NODMA
PH9  TIM12_CH2 TIM12 PWM(14) GPIO(63) NODMA

PI5  TIM8_CH1  TIM8  PWM(15) GPIO(64)
PI6  TIM8_CH2  TIM8  PWM(16) GPIO(65)

# 默认情况下允许16个PWM
define BOARD_PWM_COUNT_DEFAULT 16

# RC 输入
PC6 TIM3_CH1 TIM3 RCININT PULLUP LOW 

# 模拟输入
PF11 BATT_VOLTAGE_SENS ADC1 SCALE(1)
PA6  VDD_5V_SENS ADC1 SCALE(2)

# ADC3.3/ADC6.6
PB1 SPARE1_ADC1 ADC1 SCALE(1)
PC0 SPARE2_ADC1 ADC1 SCALE(2)

# CAN 总线
PI9  CAN1_RX CAN1
PH13 CAN1_TX CAN1

# CAN 总线2
PB5  CAN2_RX CAN2
PB6  CAN2_TX CAN2

# 无输出CAN控制
PI10 GPIO_CAN1_SILENT OUTPUT PUSHPULL SPEED_LOW LOW GPIO(70)
PG15 GPIO_CAN2_SILENT OUTPUT PUSHPULL SPEED_LOW LOW GPIO(71)

PA9 VBUS INPUT OPENDRAIN

# 内存卡引脚？
PF4  DRDY1_ADIS16470 INPUT GPIO(93)

# 使用GPIO（93）在ADIS16470上读取/存储数据？
define ADIS_DRDY_PIN 93

# 使用SPI的设备
SPIDEV adis16470      SPI5 DEVID1  ADIS16470_CS    MODE3  1*MHZ  2*MHZ
SPIDEV icm42688       SPI1 DEVID1  ICM42688_CS     MODE3  2*MHZ  8*MHZ
SPIDEV ms5611         SPI4 DEVID1  MS5611_CS       MODE3  20*MHZ 20*MHZ
SPIDEV ramtron        SPI2 DEVID1  FRAM_CS         MODE3  8*MHZ  8*MHZ 

# 一个气压计
BARO MS56XX SPI:ms5611

# 两个 IMU
IMU ADIS1647x    SPI:adis16470 ROTATION_PITCH_180_YAW_270 ADIS_DRDY_PIN
IMU Invensensev3 SPI:icm42688 ROTATION_PITCH_180

define HAL_DEFAULT_INS_FAST_SAMPLE 5

# 磁罗盘
define HAL_PROBE_EXTERNAL_I2C_COMPASSES
COMPASS IST8310 I2C:ALL_EXTERNAL:0x0E true  ROTATION_ROLL_180_YAW_90
COMPASS IST8310 I2C:ALL_INTERNAL:0x0E false ROTATION_ROLL_180

# microSD卡 
PC8 SDMMC1_D0 SDMMC1
PC9 SDMMC1_D1 SDMMC1
PC10 SDMMC1_D2 SDMMC1
PC11 SDMMC1_D3 SDMMC1
PC12 SDMMC1_CK SDMMC1
PD2 SDMMC1_CMD SDMMC1

# 启用RAMTROM参数存储
define HAL_STORAGE_SIZE 32768
define HAL_WITH_RAMTRON 1

# 启用FAT文件系统支持（需要通过SDMMC定义的microSD）
define HAL_OS_FATFS_IO 1

define HAL_BOARD_LOG_DIRECTORY "/APM/LOGS"
define HAL_BOARD_TERRAIN_DIRECTORY "/APM/TERRAIN"

DMA_PRIORITY  ADC* SPI5* TIM*UP*
DMA_NOSHARE  SPI5* TIM*UP* 
=======

# 该文件用于定义飞控硬件的设计定义，系统将根据该文件编译对应的固件以适应该版本硬件的设计。

# MCU的型号和特定类型
MCU STM32H7xx STM32H743xx

# 晶振频率定义
OSCILLATOR_HZ 16000000

# 固件加载的板卡ID
# 这个是什么意思？或者具体用的时候该怎么赋值？
APJ_BOARD_ID 777

# FLASH 的大小
FLASH_SIZE_KB 2048


# 对于2M闪存的FLASH进行速度优化
# 这个是什么意思？或者具体用的时候该怎么赋值？
env OPTIMIZE -O2


# ChibiOS系统计时器
# 这个是代表什么？
STM32_ST_USE_TIMER 2


#引导加载程序占用第一个扇区
FLASH_RESERVE_START_KB 128

# UART（和USB）的顺序
# 这条语句的语法规则是什么？
SERIAL_ORDER OTG1 USART1 USART3 USART2 UART4 UART5 USART6 UART7 UART8 OTG2

# 在更新驱动程序之前，将第二个接口默认为MAVLink2
define HAL_OTG2_PROTOCOL SerialProtocol_MAVLink2

# 定义USB连接的引脚
PA11 OTG_FS_DM OTG1
PA12 OTG_FS_DP OTG1

# 使用烧录器探针进行SWD调试的引脚
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# SPI1 - 内部imu传感器，ICM-42688-P
PA5 SPI1_SCK SPI1
PG9 SPI1_MISO SPI1
