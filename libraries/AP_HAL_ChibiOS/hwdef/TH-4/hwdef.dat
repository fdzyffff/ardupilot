PC3 SPI2_MOSI SPI2

# SPI4 - 内部气压计，MS5611
PE2 SPI4_SCK SPI4
PE5 SPI4_MISO SPI4
PE6 SPI4_MOSI SPI4

# SPI5 - 内部imu传感器, ADIS16470
PF7 SPI5_SCK SPI5
PF8 SPI5_MISO SPI5
PF9 SPI5_MOSI SPI5


# 这几行代码是什么意思？作用是什么？
PF5 ADIS16470_CS CS
PD6 ICM42688_CS CS
PI2 FRAM_CS CS SPEED_VERYLOW
PE3 MS5611_CS CS

# I2C总线

# 板载 内部I2C总线1
PB8 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

# 外部I2C总线2
PF1 I2C2_SCL I2C2
PF0 I2C2_SDA I2C2

# I2C3
PH7 I2C3_SCL I2C3
PH8 I2C3_SDA I2C3

# I2C总线的顺序
I2C_ORDER I2C1 I2C2 I2C3

define HAL_I2C_INTERNAL_MASK 1

# 启用引脚
PC13 VDD_3V3_SENSORS_EN OUTPUT LOW
PC14 VDD_3V3_SD_CARD_EN OUTPUT HIGH

# USART1定义为串口1
PB15 USART1_RX USART1
PB14 USART1_TX USART1

# USART3 定义义为串口2
PD9  USART3_RX USART3 NODMA
PB10 USART3_TX USART3 NODMA

# USART2 默认为GPS1
PA3 USART2_RX USART2 NODMA
PD5 USART2_TX USART2 NODMA

# UART4 默认为GPS2
PH14 UART4_RX UART4
PD1  UART4_TX UART4

# UART5
PB12 UART5_RX UART5 NODMA
PB13 UART5_TX UART5 NODMA

# USART6
PC7  USART6_RX USART6 NODMA
PG14 USART6_TX USART6 NODMA

# UART7
PF6 UART7_RX UART7 NODMA
PE8 UART7_TX UART7 NODMA

