MCU STM32H7xx STM32H743xx
OSCILLATOR_HZ 16000000
APJ_BOARD_ID 2502
FLASH_SIZE_KB 2048
env OPTIMIZE -O2
STM32_ST_USE_TIMER 2
FLASH_RESERVE_START_KB 128

#-----------------------------------------------USB/SWD/USART--------------------------------
SERIAL_ORDER OTG1 USART6 USART2 USART3 UART4 UART7  USART1 UART8 OTG2
#default the 2nd interface to MAVLink2 until MissionPlanner updates drivers
#define HAL_OTG2_PROTOCOL SerialProtocol_MAVLink2

PA11 	OTG_FS_DM OTG1
PA12 	OTG_FS_DP OTG1
PA13 	JTMS-SWDIO SWD
PA14 	JTCK-SWCLK SWD
PA9   	VBUS INPUT OPENDRAIN

PG9   	USART6_RX USART6
PG14  	USART6_TX USART6
PG15  	USART6_CTS USART6
PG8  	USART6_RTS USART6

PD6   	USART2_RX USART2
PD5   	USART2_TX USART2
PD8   	USART3_TX USART3 NODMA
PD9   	USART3_RX USART3 NODMA
PD0   	UART4_RX UART4 NODMA
PD1   	UART4_TX UART4 NODMA

PE7   	UART7_RX UART7
PE8   	UART7_TX UART7
PB15  	USART1_RX USART1
PB14		USART1_TX USART1
PE0   	UART8_RX UART8
PE1   	UART8_TX UART8


#--------------------------------------------Ethernet---------------------------------------
PB11 	ETH_RMII_TX_EN     	ETH1
PB12 	ETH_RMII_TXD0      	ETH1
PB13 	ETH_RMII_TXD1      	ETH1
PC4  	ETH_RMII_RXD0      	ETH1
PC5  	ETH_RMII_RXD1      	ETH1
PA7  	ETH_RMII_CRS_DV   	ETH1
PA1  	ETH_RMII_REF_CLK   ETH1
PC1  	ETH_MDC            	ETH1
PA2  	ETH_MDIO           	ETH1

PG7 GPIO_ETH_ENABLE OUTPUT HIGH GPIO(113)
define HAL_GPIO_ETH_ENABLE 113

define BOARD_PHY_ID  MII_LAN8720_ID
define BOARD_PHY_RMII
define HAL_PERIPH_ENABLE_NETWORKING

#-------------------------------------------------I2C----------------------------------------
PB8 I2C1_SCL I2C1
PB9 I2C1_SDA I2C1
PF1 I2C2_SCL I2C2
PF0 I2C2_SDA I2C2
PH7 I2C3_SCL I2C3
PH8 I2C3_SDA I2C3
#PF14 I2C4_SCL I2C4
#PF15 I2C4_SDA I2C4

I2C_ORDER I2C1 I2C2 I2C3
define HAL_I2C_INTERNAL_MASK 1

#----------------------------------------------PWM/AUX-----------------------------------------------
PE9  	TIM1_CH1 TIM1 PWM(1) GPIO(50)
PE11 TIM1_CH2 TIM1 PWM(2) GPIO(51)
PE13 TIM1_CH3 TIM1 PWM(3) GPIO(52)
PE14 TIM1_CH4 TIM1 PWM(4) GPIO(53)

PD12 TIM4_CH1  TIM4  PWM(5)  GPIO(54)
PD13 TIM4_CH2  TIM4  PWM(6) GPIO(55)
PD14 TIM4_CH3  TIM4  PWM(7) GPIO(56)
PD15 TIM4_CH4  TIM4  PWM(8) GPIO(57)

PH10 TIM5_CH1  TIM5  PWM(9)  GPIO(58)
PH11 TIM5_CH2  TIM5  PWM(10) GPIO(59)
PH12 TIM5_CH3  TIM5  PWM(11) GPIO(60)
PI0     TIM5_CH4  TIM5  PWM(12) GPIO(61)

PC6 TIM3_CH1  TIM3  PWM(13)  GPIO(62) NODMA
PC7 TIM3_CH2  TIM3  PWM(14) GPIO(63) NODMA
PB0 TIM3_CH3  TIM3  PWM(15) GPIO(64) NODMA
PB1 TIM3_CH4  TIM3  PWM(16) GPIO(65) NODMA

PI5 TIM8_CH1  TIM8  PWM(17)  GPIO(66) NODMA
PI6 TIM8_CH2  TIM8  PWM(18) GPIO(67) NODMA
PI7 TIM8_CH3  TIM8  PWM(19) GPIO(68) NODMA
PA3 TIM15_CH2  TIM15  PWM(20) GPIO(69) NODMA

define BOARD_PWM_COUNT_DEFAULT 20
PH6 TIM12_CH1 TIM12 RCININT PULLDOWN LOW

#TEMP
#PA8 HEATER_EN OUTPUT LOW GPIO(80)
#define HAL_HEATER_GPIO_PIN 80
#define HAL_HAVE_IMU_HEATER 1

# default to 45C target temp
#define HAL_IMU_TEMP_DEFAULT 45
 
#----------------------------------------------------ADC-------------------------------------------
PH2 BATT_CURRENT_SENS   	ADC3 SCALE(1)
PH3 BATT_VOLTAGE_SENS   	ADC3 SCALE(1)
PH4 BATT2_CURRENT_SENS 	ADC3 SCALE(1)
PH5 BATT2_VOLTAGE_SENS 	ADC3 SCALE(1)

define HAL_BATT_MONITOR_DEFAULT 4
define HAL_BATT_VOLT_PIN 14
define HAL_BATT_CURR_PIN 13
define HAL_BATT2_VOLT_PIN 16
define HAL_BATT2_CURR_PIN 15
define HAL_BATT_VOLT_SCALE 11
define HAL_BATT_CURR_SCALE 11

PF11 SPARE1_ADC1 ADC1 SCALE(1)
PF12 SPARE2_ADC1 ADC1 SCALE(1)
PF4 VDD_5V_SENS ADC3 SCALE(2)
PF5 SCALED_V3V3 ADC3 SCALE(2)
PF6 FMU_SERVORAIL_VCC_SENS ADC3 SCALE(3)

PF3 RSSI_IN ADC3 SCALE(1)

#-----------------------------------------------------CAN------------------------------------------
PH14 	CAN1_RX CAN1
PH13 	CAN1_TX CAN1
PB5 		CAN2_RX CAN2
PB6 		CAN2_TX CAN2

# control for silent (no output) for CAN
PH15 	GPIO_CAN1_SILENT OUTPUT PUSHPULL SPEED_LOW LOW GPIO(70)
PB7 		GPIO_CAN2_SILENT OUTPUT PUSHPULL SPEED_LOW LOW GPIO(71)

#---------------------------------------SPI/CS/DRDY------------------------------------
PA5		SPI1_SCK SPI1
PA6   	SPI1_MISO SPI1
PD7   	SPI1_MOSI SPI1

PI1 		SPI2_SCK SPI2
PI2 		SPI2_MISO SPI2
PI3 		SPI2_MOSI SPI2

PE2 		SPI4_SCK SPI4
PE5 		SPI4_MISO SPI4
PE6 		SPI4_MOSI SPI4

PF7 		SPI5_SCK SPI5
PF8 		SPI5_MISO SPI5
PF9 		SPI5_MOSI SPI5

# CS pins
PG10	ADIS16470_CS CS
PI10 		IIM42_CS CS
PE3    	ICM42_CS CS
PI8    	BMI_A_CS CS
PC13  	BMI_G_CS CS

PA0  	BARO_CS CS
PI4     	MAG_CS CS
PF10 	FRAM_CS CS

# drdy pins
PG11  	DRDY1_ADIS16470 INPUT GPIO(93)
PI11		DRDY5_IIM42 INPUT
PI9  		DRDY2_ICM42 INPUT


# use GPIO(93) for data ready on ADIS16470
define ADIS_DRDY_PIN 93

#--------------------------------------------------SPI devices-----------------------------------
SPIDEV SPL06    	SPI1 DEVID1 	BARO_CS 		MODE3  1*MHZ  8*MHZ
SPIDEV adis16470    	SPI2 DEVID2  	ADIS16470_CS 	MODE3  1*MHZ  2*MHZ
SPIDEV bmi088_a     	SPI4 DEVID2  	BMI_A_CS 	MODE3  10*MHZ 10*MHZ
SPIDEV bmi088_g     SPI4 DEVID3  	BMI_G_CS		MODE3  10*MHZ 10*MHZ
SPIDEV icm42688     SPI4 DEVID5  	ICM42_CS 	MODE3  2*MHZ  16*MHZ
SPIDEV iim42653    	SPI4 DEVID1  	IIM42_CS     	MODE3  2*MHZ  16*MHZ
SPIDEV iim42652    	SPI4 DEVID1  	IIM42_CS     	MODE3  2*MHZ  16*MHZ

IMU ADIS1647x    	SPI:adis16470 	ROTATION_ROLL_180 ADIS_DRDY_PIN
IMU 	BMI088 		SPI:bmi088_a 	SPI:bmi088_g 	ROTATION_YAW_180
IMU 	Invensensev3 	SPI:icm42688 				ROTATION_YAW_270
IMU Invensensev3 	SPI:iim42652 				ROTATION_YAW_270
IMU Invensensev3 	SPI:iim42653 				ROTATION_YAW_270

COMPASS BMM150 I2C:0:0x10 false ROTATION_PITCH_180
COMPASS BMM150 I2C:1:0x10 false ROTATION_PITCH_180

BARO SPL06	SPI:SPL06
BARO ICP201XX I2C:0:0x64
BARO ICP201XX I2C:1:0x64

define HAL_PROBE_EXTERNAL_I2C_BAROS
define HAL_BARO_ALLOW_INIT_NO_BARO

define HAL_DEFAULT_INS_FAST_SAMPLE 7

define ALLOW_ARM_NO_COMPASS
define HAL_COMPASS_DEFAULT HAL_COMPASS_NONE
define HAL_PROBE_EXTERNAL_I2C_COMPASSES
define HAL_I2C_INTERNAL_MASK 1
define HAL_COMPASS_AUTO_ROT_DEFAULT 2

#---------------------------------------------------FLASH/SD---------------------------------------------
SPIDEV ramtron              	SPI5 DEVID1  FRAM_CS            	MODE3  8*MHZ  8*MHZ

# enable logging to dataflash
#define HAL_LOGGING_DATAFLASH_ENABLED 1

define HAL_STORAGE_SIZE 32768
define HAL_WITH_RAMTRON 1

PC8 SDMMC1_D0 SDMMC1
PC9 SDMMC1_D1 SDMMC1
PC10 SDMMC1_D2 SDMMC1
PC11 SDMMC1_D3 SDMMC1
PC12 SDMMC1_CK SDMMC1
PD2 SDMMC1_CMD SDMMC1

# enable FAT filesystem support (needs a microSD defined via SDMMC)
define HAL_OS_FATFS_IO 1

#-------------------------------------------------------------RGB----------------------------------------
#define AP_NOTIFY_GPIO_LED_RGB_ENABLED 1
#PG6 LED_RED OUTPUT 	GPIO(10)
#PG3 LED_GREEN OUTPUT GPIO(11)
#PG2 LED_BLUE OUTPUT 	GPIO(12)

#define AP_NOTIFY_GPIO_LED_RGB_RED_PIN 10
#define AP_NOTIFY_GPIO_LED_RGB_GREEN_PIN 11
#define AP_NOTIFY_GPIO_LED_RGB_BLUE_PIN 12

PG6 	LED_R1 OUTPUT OPENDRAIN HIGH GPIO(0)
PG3 	LED_G1 OUTPUT OPENDRAIN LOW  GPIO(1)
PG2 	LED_B1 OUTPUT OPENDRAIN HIGH GPIO(2)
define HAL_GPIO_A_LED_PIN 0
define HAL_GPIO_B_LED_PIN 1
define HAL_GPIO_C_LED_PIN 2
define HAL_GPIO_LED_ON  0
define HAL_GPIO_LED_OFF 1
define HAL_HAVE_PIXRACER_LED

define DEFAULT_NTF_LED_TYPES 257
------------------------------------------------------------DMA-----------------------------------------
DMA_PRIORITY  ADC* SPI4* TIM*UP*
DMA_NOSHARE  SPI1* TIM*UP* 