# setup correct defaults for battery monitoring for holybro power brick
BATT_MONITOR 4

BATT2_CURR_PIN 4
BATT2_VOLT_PIN 8

# HUOJIAN: GPS1 走 ExternalAHRS 注入通道（拦截机位置由 MAV_CMD_USER_7/31016 注入）
GPS1_TYPE 21
# HUOJIAN: 选中 LK 后端，31016 注入的 GPS 数据才能进 AP_GPS
EAHRS_TYPE 12
# HUOJIAN: LK 只声明 GPS 传感器（避免被当成姿态/位置主源）
EAHRS_SENSORS 1

# HUOJIAN: CHASE 上行报文（11050/11051/11052）在 EXTRA3 组，各链路保底开 1Hz
# （实际使用由地面站主动拉流，这里只是保底配置）
MAV1_EXTRA3 1
MAV2_EXTRA3 1
MAV3_EXTRA3 1
MAV4_EXTRA3 1

# HUOJIAN: 相机与位置两路目标源默认打开（UATK_TCAM_USE: 1=HY 2=DYT2；位置源为打击模式兜底）
UATK_TCAM_USE 1
UATK_TLOC_USE 1
# HUOJIAN: 速度滞后补偿（直接法）默认打开
UATK_VEL_USE 1
